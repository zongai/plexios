<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PlexWindows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PlexWindows.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!--
              Official Plex desktop visual language (dark):
              near-black canvas, elevated panels, gold accent #E5A00D
            -->
            <Color x:Key="PlexBackgroundColor">#FF121212</Color>
            <Color x:Key="PlexSurfaceColor">#FF1B1B1B</Color>
            <Color x:Key="PlexSurfaceElevatedColor">#FF282828</Color>
            <Color x:Key="PlexSidebarColor">#FF191919</Color>
            <Color x:Key="PlexAccentColor">#FFE5A00D</Color>
            <Color x:Key="PlexAccentHoverColor">#FFF0B429</Color>
            <Color x:Key="PlexPrimaryTextColor">#FFF5F5F5</Color>
            <Color x:Key="PlexSecondaryTextColor">#FFA3A3A3</Color>
            <Color x:Key="PlexMutedTextColor">#FF6B6B6B</Color>
            <Color x:Key="PlexStrokeColor">#22FFFFFF</Color>
            <Color x:Key="PlexFocusColor">#FFE5A00D</Color>

            <SolidColorBrush x:Key="PlexBackgroundBrush" Color="{StaticResource PlexBackgroundColor}" />
            <SolidColorBrush x:Key="PlexSurfaceBrush" Color="{StaticResource PlexSurfaceColor}" />
            <SolidColorBrush x:Key="PlexSurfaceElevatedBrush" Color="{StaticResource PlexSurfaceElevatedColor}" />
            <SolidColorBrush x:Key="PlexSidebarBrush" Color="{StaticResource PlexSidebarColor}" />
            <SolidColorBrush x:Key="PlexAccentBrush" Color="{StaticResource PlexAccentColor}" />
            <SolidColorBrush x:Key="PlexAccentHoverBrush" Color="{StaticResource PlexAccentHoverColor}" />
            <SolidColorBrush x:Key="PlexPrimaryTextBrush" Color="{StaticResource PlexPrimaryTextColor}" />
            <SolidColorBrush x:Key="PlexSecondaryTextBrush" Color="{StaticResource PlexSecondaryTextColor}" />
            <SolidColorBrush x:Key="PlexMutedTextBrush" Color="{StaticResource PlexMutedTextColor}" />
            <SolidColorBrush x:Key="PlexStrokeBrush" Color="{StaticResource PlexStrokeColor}" />
            <SolidColorBrush x:Key="PlexFocusBrush" Color="{StaticResource PlexFocusColor}" />

            <!-- Layout tokens aligned with dense media desktop clients -->
            <Thickness x:Key="PagePadding">28,20,28,28</Thickness>
            <Thickness x:Key="HubRowPadding">0,4,0,20</Thickness>
            <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
            <x:Double x:Key="PosterCardWidth">140</x:Double>
            <x:Double x:Key="PosterCardHeight">210</x:Double>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource PlexPrimaryTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource PlexPrimaryTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="BodySecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource PlexSecondaryTextBrush}" />
            </Style>
            <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource PlexSecondaryTextBrush}" />
            </Style>

            <!-- Clean poster chrome (official-like: minimal border, soft radius) -->
            <Style x:Key="MediaCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <!-- Primary action = Plex gold -->
            <Style x:Key="PlexPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{StaticResource PlexAccentBrush}" />
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
