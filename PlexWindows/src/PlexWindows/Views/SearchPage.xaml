<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PlexWindows.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlexWindows.ViewModels"
    xmlns:helpers="using:PlexWindows.Helpers"
    Background="{StaticResource PlexBackgroundBrush}">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="QueryBox" Grid.Row="0"
                 PlaceholderText="Search movies, shows, music…"
                 Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="18"
                 KeyUp="QueryBox_KeyUp" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="{StaticResource PlexSecondaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchHubCards">
                        <StackPanel Margin="0,0,0,20" Spacing="8">
                            <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource PlexPrimaryTextBrush}" />
                            <ItemsRepeater ItemsSource="{x:Bind Items}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="helpers:MediaCardItem">
                                        <Button Background="{StaticResource PlexSurfaceBrush}" BorderThickness="0"
                                                Padding="10" Click="Result_Click" Tag="{x:Bind}">
                                            <StackPanel Width="130" Spacing="4">
                                                <Border Height="160" Background="#333" CornerRadius="4">
                                                    <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Title}" MaxLines="2" TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Foreground="{StaticResource PlexPrimaryTextBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
