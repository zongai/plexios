<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PlexWindows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PlexWindows.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Brand tokens (dark, Fluent-aligned) -->
            <Color x:Key="PlexBackgroundColor">#FF0F0F0F</Color>
            <Color x:Key="PlexSurfaceColor">#FF1C1C1C</Color>
            <Color x:Key="PlexSurfaceElevatedColor">#FF2A2A2A</Color>
            <Color x:Key="PlexAccentColor">#FFE5A00D</Color>
            <Color x:Key="PlexPrimaryTextColor">#FFF3F3F3</Color>
            <Color x:Key="PlexSecondaryTextColor">#FFC5C5C5</Color>
            <Color x:Key="PlexStrokeColor">#33FFFFFF</Color>

            <SolidColorBrush x:Key="PlexBackgroundBrush" Color="{StaticResource PlexBackgroundColor}" />
            <SolidColorBrush x:Key="PlexSurfaceBrush" Color="{StaticResource PlexSurfaceColor}" />
            <SolidColorBrush x:Key="PlexSurfaceElevatedBrush" Color="{StaticResource PlexSurfaceElevatedColor}" />
            <SolidColorBrush x:Key="PlexAccentBrush" Color="{StaticResource PlexAccentColor}" />
            <SolidColorBrush x:Key="PlexPrimaryTextBrush" Color="{StaticResource PlexPrimaryTextColor}" />
            <SolidColorBrush x:Key="PlexSecondaryTextBrush" Color="{StaticResource PlexSecondaryTextColor}" />
            <SolidColorBrush x:Key="PlexStrokeBrush" Color="{StaticResource PlexStrokeColor}" />

            <!-- Fluent spacing / radius -->
            <Thickness x:Key="PagePadding">24</Thickness>
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>

            <!-- Page title (Fluent TitleTextBlockStyle + brand color) -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource PlexPrimaryTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource PlexPrimaryTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="BodySecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource PlexSecondaryTextBrush}" />
            </Style>
            <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource PlexSecondaryTextBrush}" />
            </Style>

            <!-- Poster card chrome -->
            <Style x:Key="MediaCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PlexSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PlexStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Transparent button used as card host (keyboard focus visible) -->
            <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
