<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PlexWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PlexWindows.Views"
    Title="Plex">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="{StaticResource PlexBackgroundBrush}">
        <!-- Content is swapped between SignIn and Shell -->
        <Frame x:Name="RootFrame" />
    </Grid>
</Window>
