<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PlexWindows.Views.IptvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iptv="using:PlexWindows.Iptv"
    Background="{StaticResource PlexBackgroundBrush}">
    <Grid Padding="{StaticResource PagePadding}" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Playlists / add -->
        <StackPanel Grid.Column="0" Spacing="10">
            <TextBlock Text="IPTV" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Playlists" Style="{StaticResource SectionHeaderStyle}" />
            <TextBox Header="Name" Text="{x:Bind ViewModel.NewName, Mode=TwoWay}" />
            <TextBox Header="M3U URL" Text="{x:Bind ViewModel.NewUrl, Mode=TwoWay}"
                     PlaceholderText="https://…/playlist.m3u" />
            <Button Content="Add &amp; Refresh" Click="Add_Click"
                    Style="{StaticResource PlexPlayButtonStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                      MaxHeight="280">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="iptv:IptvPlaylist">
                        <StackPanel Spacing="2" Margin="0,4">
                            <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource PlexPrimaryTextBrush}" />
                            <TextBlock Text="{x:Bind ChannelCount}" Style="{StaticResource CaptionSecondaryStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <HyperlinkButton Content="Refresh" Click="RefreshPl_Click" Tag="{x:Bind}" />
                                <HyperlinkButton Content="Delete" Click="DeletePl_Click" Tag="{x:Bind}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="28" Height="28" />
        </StackPanel>

        <!-- Channels -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox Header="Search" Width="220"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                         PlaceholderText="Channel name" />
                <ComboBox Header="Group" Width="180"
                          ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}" />
            </StackPanel>
            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Channels, Mode=OneWay}"
                      IsItemClickEnabled="True"
                      ItemClick="Channel_Click">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="iptv:IptvChannel">
                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}"
                                           Foreground="{StaticResource PlexPrimaryTextBrush}" />
                                <TextBlock Text="{x:Bind Group}"
                                           Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="▶ Play"
                                       Foreground="{StaticResource PlexAccentBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
