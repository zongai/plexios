<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PlexWindows.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:PlexWindows.Helpers"
    Background="{StaticResource PlexBackgroundBrush}">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Favorites" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Foreground="{StaticResource PlexSecondaryTextBrush}" Margin="0,8,0,12" />
        <GridView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="Item_Click">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="helpers:MediaCardItem">
                    <StackPanel Width="140" Margin="8">
                        <Border Width="140" Height="210" CornerRadius="6" Background="#22FFFFFF">
                            <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="{x:Bind Title}" TextWrapping="WrapWholeWords"
                                   MaxLines="2" Margin="0,6,0,0"
                                   Foreground="{StaticResource PlexPrimaryTextBrush}" />
                        <TextBlock Text="{x:Bind Year}" Opacity="0.7"
                                   Foreground="{StaticResource PlexSecondaryTextBrush}" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
