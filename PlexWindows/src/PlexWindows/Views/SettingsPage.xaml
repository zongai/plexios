<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PlexWindows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PlexWindows.Models"
    xmlns:vm="using:PlexWindows.ViewModels"
    Background="{StaticResource PlexBackgroundBrush}">
    <!--
      Structure mirrors iOS SettingsTabView:
      Account & Server · Playback · Player engine · Storage · About
    -->
    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="640" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <!-- Account & Server -->
            <TextBlock Text="Account &amp; Server" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,6" />
            <Border Background="{StaticResource PlexSurfaceBrush}"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="10">
                    <TextBlock>
                        <Run Text="Status: " Foreground="{StaticResource PlexSecondaryTextBrush}" />
                        <Run Text="{x:Bind ViewModel.AccountStatus, Mode=OneWay}"
                             Foreground="{StaticResource PlexPrimaryTextBrush}" />
                    </TextBlock>
                    <TextBlock Text="{x:Bind ViewModel.ActiveServerSummary, Mode=OneWay}"
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlexServer">
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,2"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource PlexStrokeBrush}"
                                        Click="Server_Click"
                                        Tag="{x:Bind}">
                                    <TextBlock Text="{x:Bind Name}"
                                               Foreground="{StaticResource PlexPrimaryTextBrush}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Refresh servers" Click="RefreshServers_Click" />
                        <Button Content="Sign out" Click="SignOut_Click"
                                Foreground="#FFFF6B6B" />
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- Home display (iOS HomeDisplaySettingsView) -->
            <TextBlock Text="Home" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
            <Border Background="{StaticResource PlexSurfaceBrush}"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="Continue Watching"
                                  IsOn="{x:Bind ViewModel.ShowContinueWatching, Mode=TwoWay}"
                                  OnContent="On" OffContent="Off" />
                    <ToggleSwitch Header="Recently Played"
                                  IsOn="{x:Bind ViewModel.ShowRecentlyPlayed, Mode=TwoWay}"
                                  OnContent="On" OffContent="Off" />
                    <ComboBox Header="Max items per row"
                              Width="160"
                              ItemsSource="{x:Bind ViewModel.MaxItemsOptions}"
                              SelectedItem="{x:Bind ViewModel.MaxItemsPerHub, Mode=TwoWay}" />
                    <TextBlock Text="Libraries on Home" Style="{StaticResource CaptionSecondaryStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryToggleItem">
                                <ToggleSwitch Header="{x:Bind Title}"
                                              IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                              OnContent="On" OffContent="Off"
                                              Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Playback (iOS PlaybackSettingsDetailView) -->
            <TextBlock Text="Playback" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
            <Border Background="{StaticResource PlexSurfaceBrush}"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="Auto-play next episode"
                                  IsOn="{x:Bind ViewModel.AutoPlayNextEpisode, Mode=TwoWay}"
                                  OnContent="On" OffContent="Off" />
                    <ToggleSwitch Header="Subtitles enabled by default"
                                  IsOn="{x:Bind ViewModel.SubtitlesEnabled, Mode=TwoWay}"
                                  OnContent="On" OffContent="Off" />
                    <ComboBox Header="Max remote quality"
                              Width="280"
                              ItemsSource="{x:Bind ViewModel.QualityOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" />
                    <ComboBox Header="Preferred audio language"
                              Width="280"
                              ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedAudioLanguage, Mode=TwoWay}" />
                    <ComboBox Header="Preferred subtitle language"
                              Width="280"
                              ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedSubtitleLanguage, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Player engine (iOS PlayerEngineSettingsView) -->
            <TextBlock Text="Player engine" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
            <Border Background="{StaticResource PlexSurfaceBrush}"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="8">
                    <ComboBox Header="Backend"
                              Width="280"
                              ItemsSource="{x:Bind ViewModel.BackendOptions}"
                              SelectedItem="{x:Bind ViewModel.PlayerBackend, Mode=TwoWay}" />
                    <TextBlock Text="auto tries Media Foundation first, then LibVLC. Direct Play failures fall back automatically."
                               Style="{StaticResource CaptionSecondaryStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Storage -->
            <TextBlock Text="Storage" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
            <Border Background="{StaticResource PlexSurfaceBrush}"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="16,12" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Clear image cache" Click="ClearCache_Click" />
                    <Button Content="Save settings" Click="Save_Click"
                            Style="{StaticResource PlexPlayButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
            <Border Background="{StaticResource PlexSurfaceBrush}"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="16,12">
                <StackPanel Spacing="6">
                    <TextBlock>
                        <Run Text="Plex Windows  ·  " Foreground="{StaticResource PlexPrimaryTextBrush}" />
                        <Run Text="{x:Bind ViewModel.AppVersion}" Foreground="{StaticResource PlexSecondaryTextBrush}" />
                    </TextBlock>
                    <TextBlock Text="Auth token is never shown or exported."
                               Style="{StaticResource CaptionSecondaryStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource BodySecondaryStyle}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
