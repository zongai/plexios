<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PlexWindows.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:PlexWindows.Helpers"
    Background="{StaticResource PlexBackgroundBrush}">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← Back" Click="Back_Click"
                    Visibility="{x:Bind ViewModel.ShowingChildren, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource PlexPrimaryTextBrush}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="{StaticResource PlexSecondaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <Grid>
                <!-- Collections grid -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Collections, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ShowingChildren, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="150" MinItemHeight="250"
                                           MinColumnSpacing="12" MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="helpers:MediaCardItem">
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Click="Collection_Click" Tag="{x:Bind}">
                                <Border Width="150" Background="{StaticResource PlexSurfaceBrush}"
                                        CornerRadius="6" Padding="8">
                                    <StackPanel Spacing="6">
                                        <Border Height="190" Background="#333" CornerRadius="4">
                                            <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Title}" MaxLines="2" TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource PlexPrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Children grid -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Children, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ShowingChildren, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="150" MinItemHeight="250"
                                           MinColumnSpacing="12" MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="helpers:MediaCardItem">
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Click="Child_Click" Tag="{x:Bind}">
                                <Border Width="150" Background="{StaticResource PlexSurfaceBrush}"
                                        CornerRadius="6" Padding="8">
                                    <StackPanel Spacing="6">
                                        <Border Height="190" Background="#333" CornerRadius="4">
                                            <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Title}" MaxLines="2" TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource PlexPrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind Year}" FontSize="11"
                                                   Foreground="{StaticResource PlexSecondaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
