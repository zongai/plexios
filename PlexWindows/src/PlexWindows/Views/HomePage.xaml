<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PlexWindows.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlexWindows.ViewModels"
    xmlns:helpers="using:PlexWindows.Helpers"
    Background="{StaticResource PlexBackgroundBrush}">
    <ScrollViewer Padding="{StaticResource PagePadding}"
                  HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
            <TextBlock Text="Home" Style="{StaticResource PageTitleStyle}" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="36" Height="36"
                          HorizontalAlignment="Left" />

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource BodySecondaryStyle}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Hubs, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HubCards">
                        <StackPanel Margin="0,0,0,8" Spacing="8">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionHeaderStyle}" />
                            <ScrollViewer HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsRepeater ItemsSource="{x:Bind Items}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="12" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:MediaCardItem">
                                            <Button Style="{StaticResource CardButtonStyle}"
                                                    Click="Item_Click" Tag="{x:Bind}"
                                                    AutomationProperties.Name="{x:Bind Title}"
                                                    ToolTipService.ToolTip="{x:Bind Title}">
                                                <Border Style="{StaticResource MediaCardBorderStyle}" Width="148">
                                                    <StackPanel>
                                                        <Border Height="210" Background="{StaticResource PlexSurfaceElevatedBrush}"
                                                                CornerRadius="8,8,0,0">
                                                            <Image Source="{x:Bind Poster}"
                                                                   Stretch="UniformToFill"
                                                                   AutomationProperties.Name="{x:Bind Title}" />
                                                        </Border>
                                                        <StackPanel Padding="10,8" Spacing="2">
                                                            <TextBlock Text="{x:Bind Title}" MaxLines="2"
                                                                       TextWrapping="WrapWholeWords"
                                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                                       Foreground="{StaticResource PlexPrimaryTextBrush}" />
                                                            <TextBlock Text="{x:Bind Year}"
                                                                       Style="{StaticResource CaptionSecondaryStyle}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
